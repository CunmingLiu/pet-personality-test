<view class="page">
  <view class="progress">{{currentIndex + 1}} / {{total}}</view>

  <view class="card" wx:if="{{!loading && total > 0}}">
    <view class="question-title">{{currentQuestion.title}}</view>
    <view class="options">
      <view
        wx:for="{{currentQuestion.options}}"
        wx:key="index"
        class="option {{selectedOptionIndex === index ? 'active' : ''}}"
        bindtap="onSelectOption"
        data-index="{{index}}"
      >
        {{item.text}}
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{!loading && total === 0}}">题目加载失败，请返回首页重试</view>
  <view class="empty" wx:if="{{loading}}">题目加载中...</view>

  <button class="next-btn" bindtap="onNext" wx:if="{{!loading && total > 0}}">
    {{isLastQuestion ? '提交测试' : '下一题'}}
  </button>

  <!-- <view class="compliance-tip">本测试仅供娱乐，非专业心理测评</view> -->
</view>
