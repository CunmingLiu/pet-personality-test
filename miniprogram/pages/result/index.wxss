page {
  background: #f7f8fc;
}

.page {
  min-height: 100vh;
  padding: 30rpx;
  box-sizing: border-box;
}

.result-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  color: #475467;
}

.result-image {
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  margin: 0 auto 24rpx;
  display: block;
}

.result-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1d2939;
}

.result-tags {
  margin-top: 18rpx;
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.tag {
  font-size: 24rpx;
  color: #b54708;
  background: #fffaeb;
  border-radius: 999rpx;
  padding: 8rpx 16rpx;
}

.result-desc {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #475467;
  line-height: 1.7;
}

.skeleton-card {
  overflow: hidden;
}

.skeleton-img,
.skeleton-line,
.skeleton-chip {
  position: relative;
  background: #eef2f6;
  border-radius: 14rpx;
}

.skeleton-img::after,
.skeleton-line::after,
.skeleton-chip::after {
  content: "";
  position: absolute;
  top: 0;
  left: -120%;
  width: 120%;
  height: 100%;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.55) 50%, rgba(255, 255, 255, 0) 100%);
  animation: shimmer 1.3s infinite;
}

.skeleton-img {
  width: 100%;
  height: 320rpx;
  margin-bottom: 22rpx;
  border-radius: 16rpx;
}

.skeleton-line {
  height: 28rpx;
  margin-top: 14rpx;
}

.skeleton-line.w80 {
  width: 80%;
  height: 40rpx;
  margin-top: 0;
}

.skeleton-line.w60 {
  width: 60%;
}

.skeleton-tags {
  margin-top: 18rpx;
  display: flex;
  gap: 12rpx;
}

.skeleton-chip {
  width: 120rpx;
  height: 38rpx;
  border-radius: 999rpx;
}

.skeleton-chip.short {
  width: 90rpx;
}

@keyframes shimmer {
  100% {
    left: 120%;
  }
}

.action-btn {
  margin-top: 22rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background: #ff7a45;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: normal;
  padding: 0;
  box-sizing: border-box;
}

.action-btn::after {
  border: none;
}

.share-btn {
  background: #f59e0b;
}

.ghost-btn {
  background: #ffffff;
  color: #344054;
  border: 2rpx solid #d0d5dd;
}

.poster-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 600px;
  height: 900px;
}

.poster-modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 98;
}

.poster-modal {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100vw;
  max-height: 88vh;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 44rpx 28rpx 22rpx;
  box-sizing: border-box;
  z-index: 99;
}

.poster-modal-close {
  position: absolute;
  right: 16rpx;
  top: 8rpx;
  z-index: 3;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 54rpx;
  line-height: 1;
  color: #98a2b3;
}

.poster-preview-wrap {
  width: 74%;
  height: 0;
  padding-top: 111%;
  margin: 0 auto;
  position: relative;
  border-radius: 20rpx;
  background: #f8fafc;
  overflow: hidden;
}

.poster-preview-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.poster-modal-tip {
  margin-top: 20rpx;
  text-align: center;
  color: #667085;
  font-size: 24rpx;
}
.btn-container{
  display: flex;
  justify-content: center;
}
.poster-save-btn {
  width:225rpx !important;
  margin: 12rpx auto 0;
  height: 65rpx;
  margin-top: 15rpx;
  font-size: 35rpx;
}

.compliance-tip {
  margin-top: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: #98a2b3;
}