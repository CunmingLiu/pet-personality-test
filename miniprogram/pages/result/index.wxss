page {
  background: #f7f8fc;
}

.page {
  min-height: 100vh;
  padding: 30rpx;
  box-sizing: border-box;
}

.result-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  color: #475467;
}

.result-image {
  width: 100%;
  height: 320rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  /* background: #f2f4f7; */
}

.result-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1d2939;
}

.result-tags {
  margin-top: 18rpx;
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.tag {
  font-size: 24rpx;
  color: #b54708;
  background: #fffaeb;
  border-radius: 999rpx;
  padding: 8rpx 16rpx;
}

.result-desc {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #475467;
  line-height: 1.7;
}

.action-btn {
  margin-top: 22rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background: #ff7a45;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: normal;
  padding: 0;
  box-sizing: border-box;
}

.action-btn::after {
  border: none;
}

.share-btn {
  background: #f59e0b;
}

.ghost-btn {
  background: #ffffff;
  color: #344054;
  border: 2rpx solid #d0d5dd;
}

.poster-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 600px;
  height: 960px;
}

.compliance-tip {
  margin-top: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: #98a2b3;
}
